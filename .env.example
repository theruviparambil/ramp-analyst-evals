# ramp-analyst-evals — API keys for the LIVE agent + eval (`npm run eval`, `npm run demo`, `npm run ask`).
#
# The test suite (`npm test`) needs NONE of these: the agent loop runs against a
# scripted LLM client, and execute_analyst_query hits a local in-process DuckDB.
#
# Copy to .env and fill in whatever you have. The agent auto-detects which key is
# present, in this order of precedence: OPENROUTER > OPENAI > ANTHROPIC.

# --- One key, any family -----------------------------------------------------
# OpenRouter exposes every vendor behind one key and one OpenAI-compatible API.
OPENROUTER_API_KEY=

# --- Or a native provider key ------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional model-id override ----------------------------------------------
# Defaults target a current frontier model. Vendor ids churn faster than code.
# AGENT_MODEL=gpt-5.1
# AGENT_MODEL=anthropic/claude-sonnet-4.6   # e.g. via OpenRouter
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Live Ramp mode (documented seam, not built) -----------------------------
# By default the tool surface is backed by the local synthetic fixture. Setting
# RAMP_MODE=live routes tools to Ramp's demo MCP endpoint instead — see the
# "Custom agent / live mode" section of the README. It requires sandbox
# credentials and is intentionally left as a documented stub.
# RAMP_MODE=fixture
# RAMP_MCP_URL=https://demo-mcp.ramp.com/mcp
# RAMP_CLIENT_ID=
# RAMP_CLIENT_SECRET=
